#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev

set -e

RCU0_STAT=0x3108C004
BITP_RCU_STAT_BMODE=8
BITM_RCU_STAT_BMODE=0x00000F00
SPI_BMODE=1 #SPI Master Boot

# Boot flash partitions, linked by udev. The musl tiny image runs no device
# manager, so create the same links there.
MTD=/dev/mtd/by-name
if [ ! -d $MTD ]; then
  mkdir -p $MTD
  for dev in /sys/class/mtd/mtd*; do
    case "$dev" in *ro) continue ;; esac
    [ -e "$dev/name" ] || continue
    ln -sf "../../${dev##*/}" "$MTD/$(tr ' ' _ < "$dev/name")"
  done
fi

echo
echo "======== SPI Flash Installer ========"
echo "Install U-Boot to SPI Flash"
echo
echo "This will erase and program SPI flash."
printf "Continue? [y/i/N]:"

read -r ans

case "$ans" in
  i|I)
    echo "Interactive SPI flash programming..."
    echo

    # U-Boot SPL
    printf "Install U-Boot SPL to the u-boot-spl partition? [y/N]: "
    read -r spl_ans
    if [ "$spl_ans" = "y" ] || [ "$spl_ans" = "Y" ]; then
      echo "Installing U-boot SPL..."
      flash_erase $MTD/u-boot-spl 0 0
      flashcp /usr/firmware/u-boot-spl.ldr $MTD/u-boot-spl
    fi

    # U-Boot
    printf "Install U-Boot to the u-boot partition? [y/N]: "
    read -r uboot_ans
    if [ "$uboot_ans" = "y" ] || [ "$uboot_ans" = "Y" ]; then
      echo "Installing U-boot..."
      flash_erase $MTD/u-boot 0 0
      flashcp /usr/firmware/u-boot.ldr $MTD/u-boot
    fi

    # Linux kernel
    printf "Install Linux kernel (fitImage) to the kernel partition? [y/N]: "
    read -r kernel_ans
    if [ "$kernel_ans" = "y" ] || [ "$kernel_ans" = "Y" ]; then
      echo "Installing Linux kernel..."
      flash_erase $MTD/kernel 0 0
      flashcp /usr/firmware/fitImage $MTD/kernel
    fi

    # Rootfs
    printf "Install rootfs to the rootfs partition? [y/N]: "
    read -r rootfs_ans
    if [ "$rootfs_ans" = "y" ] || [ "$rootfs_ans" = "Y" ]; then
      echo "Writing rootfs UBI image to the rootfs partition..."
      ubiformat $MTD/rootfs -f /usr/firmware/rootfs.ubi -y > /dev/null
    fi

    sync
    echo "Interactive SPI install complete"
    ;;
  y|Y)
    echo "Installing to SPI flash..."

    echo "Installing U-boot SPL..."
    flash_erase $MTD/u-boot-spl 0 0
    flashcp /usr/firmware/u-boot-spl.ldr $MTD/u-boot-spl

    echo "Installing U-boot..."
    flash_erase $MTD/u-boot 0 0
    flashcp /usr/firmware/u-boot.ldr $MTD/u-boot

    echo "Installing Linux kernel"
    flash_erase $MTD/kernel 0 0
    flashcp /usr/firmware/fitImage $MTD/kernel

    echo "Writing rootfs UBI image to the rootfs partition..."
    ubiformat $MTD/rootfs -f /usr/firmware/rootfs.ubi -y > /dev/null

    sync
    echo "SPI install complete"
    ;;
  *)
    echo "Skipping SPI install"
    ;;
esac

echo
echo "======== Emmc Installer ========"

MACHINE_MODEL=$(cat /proc/device-tree/model 2>/dev/null | tr -d '\0' || echo "unknown")
case "$MACHINE_MODEL" in
  *"SC598"*|*"SC84X"*)
    echo "Install U-Boot to EMMC"
    echo
    echo "This will erase and program EMMC."
    printf "Continue? [y/N]: "

    read -r ans

    case "$ROOT_DEV" in
      /dev/mmcblk0*)
        echo "The root filesystem is mounted from the eMMC."
        echo "Boot from NFS or the SPI flash to program the eMMC."
        ans=n
        ;;
    esac

    case "$ans" in
      y|Y)
        echo "Installing to EMMC..."

        # emmc.img holds U-Boot SPL and U-Boot, partition 1 with the
        # fitImage and partition 2 with the rootfs
        echo "Writing emmc.img to the eMMC..."
        dd if=/usr/firmware/emmc.img of=/dev/mmcblk0 bs=64K conv=fsync

        sync
        echo "EMMC install complete"
        ;;
      *)
        echo "Skipping EMMC install"
        ;;
    esac
    ;;
  *)
    echo "eMMC programming is only supported on adsp-sc598-som-ezkit, adsp-sc598-som-ezlite and adsp-sc846-som-ezkit machines."
    echo "Current machine: $MACHINE_MODEL"
    echo "Skipping eMMC installer."
    ;;
esac

if [ -f /usr/firmware/nand.img ]; then
  echo
  echo "======== NAND Installer ========"

  # The carrier xSPI1 flash is a NOR or a NAND, depending on the board
  NAND_TYPE=
  if [ -e $MTD/xspi1-data ]; then
    NAND_MTD=$(readlink $MTD/xspi1-data)
    NAND_TYPE=$(cat "/sys/class/mtd/${NAND_MTD##*/}/type")
  fi

  case "$NAND_TYPE" in
    *nand)
      echo "Install nand.img to the xspi1-data NAND"
      echo
      echo "This will erase and program the NAND."
      printf "Continue? [y/N]: "

      read -r ans

      case "$ans" in
        y|Y)
          echo "Writing nand.img to the NAND..."
          ubiformat $MTD/xspi1-data -f /usr/firmware/nand.img -y > /dev/null
          sync
          echo "NAND install complete"
          ;;
        *)
          echo "Skipping NAND install"
          ;;
      esac
      ;;
    *)
      echo "The xspi1-data flash isn't a NAND, skipping the NAND installer."
      ;;
  esac
fi

if [ -f /usr/firmware/usb.img ]; then
  echo
  echo "======== USB Installer ========"
  echo
  echo "This will erase and program the USB."
  printf "Continue? [y/N]: "

  read -r ans

  case "$ans" in
    y|Y)
      echo "Installing to USB..."

      # usb.img holds partition 1 with the fitImage and partition 2 with
      # the rootfs
      echo "Writing usb.img to the USB..."
      dd if=/usr/firmware/usb.img of=/dev/sda bs=64K conv=fsync

      sync
      echo "USB install complete"
      ;;
    *)
      echo "Skipping USB install"
      ;;
  esac
fi

echo
echo "Set the switch S1 to position 1 (SPI boot)."
echo "Waiting for switch..."

while true; do
    val=$(devmem $RCU0_STAT 32)
    mode=$(( (val & BITM_RCU_STAT_BMODE) >> BITP_RCU_STAT_BMODE))

    if [ "$mode" -eq "$SPI_BMODE" ]; then
        echo "SPI boot mode detected."
        echo "Rebooting..."
        reboot -f
        exit 0
    fi

    sleep 1
done
