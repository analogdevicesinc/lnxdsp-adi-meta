#
# Allocates blocks from each on-chip SRAM pool, checks where they are and that
# data written to them reads back, and frees them.
# The module runs the test when it is loaded, and fails to load if the test
# fails. It is skipped on boards without an mmio-sram pool.

# Timestamp of the last kernel message before the test
last=$(dmesg | tail -n 1 | sed -n 's/^\[ *\([0-9.]*\)\].*/\1/p')

rmmod hello_l2_alloc 2>/dev/null
modprobe hello_l2_alloc
status=$?
rmmod hello_l2_alloc 2>/dev/null

log=$(dmesg | awk -v last="${last:-0}" '{
	t = $0
	sub(/^\[ */, "", t)
	sub(/\].*/, "", t)
	if (t + 0 > last + 0)
		print
}')
echo "$log"

if [ "$status" -eq 0 ]; then
	echo "PASS: hello_l2_alloc"
elif echo "$log" | grep -q '\] SKIP: '; then
	echo "SKIP: hello_l2_alloc (no mmio-sram pool in the device tree)"
else
	echo "FAIL: hello_l2_alloc"
	exit 1
fi
