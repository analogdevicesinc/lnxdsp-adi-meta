From a27b6f384f0f3bf9dd82a9798ecafa50dd703804 Mon Sep 17 00:00:00 2001
From: Arturs Artamonovs <Arturs.Artamonovs@analog.com>
Date: Tue, 20 May 2025 13:53:51 +0100
Subject: [PATCH] SC598 Audio configuration for hybrid audio support

Upstream-Status: Inappropriate [embedded specific]

Signed-off-by: Arturs Artamonovs <Arturs.Artamonovs@analog.com>
---
 arch/arm64/boot/dts/adi/sc598-som.dtsi | 25 ++++++++++++++--------
 arch/arm64/boot/dts/adi/sc59x-64.dtsi  | 29 +++++++++++++++++++++++++-
 2 files changed, 44 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/adi/sc598-som.dtsi b/arch/arm64/boot/dts/adi/sc598-som.dtsi
index cc3b27f7f3b1..3d63dab9c867 100644
--- a/arch/arm64/boot/dts/adi/sc598-som.dtsi
+++ b/arch/arm64/boot/dts/adi/sc598-som.dtsi
@@ -34,10 +34,10 @@ memory@20040000 {
 	};
 
 	reserved-memory {
-		sram1_res: sram1-reserved@20040000 {
-			compatible = "adi,sram-access";
-			reg = <0x20040000 0x40000>;
-		};
+		//sram1_res: sram1-reserved@20040000 {
+//			compatible = "adi,sram-access";
+//			reg = <0x20040000 0x40000>;
+//		};
 
 		vdev0vrings: vdev0vring0@20080000 {
 			reg = <0x20080000 0x4000>;
@@ -62,12 +62,15 @@ vdev1buffer: vdev1buffer@200a8000 {
 		};
 	};
 
-	sram1_mmap: sram-mmap {
-		compatible = "adi,sram-mmap";
-		memory-region = <&sram1_res>;
-		status = "okay";
+	sram2: sram-reserved@200C8000 {
+		compatible = "mmio-sram";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0x200C8000 0x138000>;
+		ranges = <0 0x200C8000 0x138000>; /*1248KiB*/
 	};
 
+
 	scb {
 		remoteproc { // XXX find a better name than "remoteproc"
 			compatible = "simple-bus";
@@ -91,7 +94,7 @@ sharc@0 {
 				      <0x0 0x20000000 0x00200000>;
 				reg-names = "l1", "l2";
 				core-id = <1>;
-				firmware-name = "adi/rpmsg_echo_sharc_core1.ldr";
+				firmware-name = "adi/icap_device_example_sharc_core1.ldr";
 				interrupts = <GIC_SPI 337 IRQ_TYPE_EDGE_RISING>; /* TRU0_SLV3 */
 				adi,svect = <&rcu 0x30>;
 				resets = <&rcu 1 0>, <&rcu 1 1>;
@@ -223,6 +226,10 @@ &usb0 {
 	status = "okay";
 };
 
+&sram_mmap {
+	status = "okay";
+};
+
 &pinctrl0 {
 	uart0_default: uart0_default_pins {
 		pins {
diff --git a/arch/arm64/boot/dts/adi/sc59x-64.dtsi b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
index a8ac7ca6ace5..e420dbf538c4 100644
--- a/arch/arm64/boot/dts/adi/sc59x-64.dtsi
+++ b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
@@ -75,6 +75,22 @@ gic: interrupt-controller@31200000 {
 		      <0x31240000 0x40000>; /* GICR */
 	};
 
+	sram0: sram-icc@20025000 {
+		compatible = "mmio-sram";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0x20025000 0x1B000>;
+		ranges = <0 0x20025000 0x1B000>; /*108KiB*/
+	};
+
+	sram1: sram-reserved@20040000 {
+		compatible = "mmio-sram";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0x20040000 0x40000>;
+		ranges = <0 0x20040000 0x40000>; /*256KiB*/
+	};
+
 	timer {
 		compatible = "arm,armv8-timer";
 		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>, /* Physical Secure */
@@ -193,6 +209,11 @@ rsc_tbl1: rsc-table@20000400 {
 			no-map;
 		};
 
+		sram_B1_unused@20000800 {
+			reg = <0x20000800 0x4800>; /*18KiB*/
+			no-map;
+		};
+
 		sharc-internal-icc@20005000 {
 			reg = <0x20005000 0x20000>; /*128KiB*/
 			no-map;
@@ -244,11 +265,17 @@ dmc_pmu: dmc-pmu@31070000 {
 		sram-controller@31080000 {
 			compatible = "adi,sram-controller";
 			reg = <0x31080000 0x100>;
-			/* adi,sram = <&sram0>, <&sram1>; */
+			adi,sram = <&sram0>, <&sram1>;
 			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
 			status = "disabled";
 		};
 
+		sram_mmap: sram-mmap@0 {
+			compatible = "adi,sram-mmap";
+			memory-region = <&sram1>;
+			status = "disabled";
+		};
+
 		rcu: rcu@3108c000 {
 			compatible = "syscon", "adi,reset-controller";
 			reg = <0x3108c000 0x1000>;
-- 
2.34.1

