From ec751d9f5a03d90783088ae1d08b38217ce65fb5 Mon Sep 17 00:00:00 2001
From: Arturs Artamonovs <Arturs.Artamonovs@analog.com>
Date: Wed, 20 Aug 2025 17:35:38 +0100
Subject: [PATCH] SC598 Enable SHARC ALSA demo disabling most linux

Upstream-Status: Inappropriate [configuration]

SHARC core 1 configures the ADAU1962 and ADAU1979 codecs itself, over
TWI2, so disable their Linux nodes and move the pinctrl states that enable
them to the remoteproc bus, made a simple-pm-bus so it only adds the
SHARCs once those states apply. Linux keeps the rest of i2c2, which holds
the SOM and carrier GPIO expanders that the eMMC and the other peripherals
need, and remoteproc only starts the SHARCs once the expanders are set up,
so Linux and the SHARC don't use TWI2 at the same time.

Signed-off-by: Caleb Ethridge <caleb.ethridge@analog.com>
---
 arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi | 18 ++++++++--
 arch/arm64/boot/dts/adi/sc598-som.dtsi       | 14 ++++----
 arch/arm64/boot/dts/adi/sc59x-64.dtsi        |  2 +-
 arch/arm64/configs/sc598-som-ezkit_defconfig |  3 ++
 drivers/soc/adi/mach-sc5xx/sec.c             | 38 +-------------------
 5 files changed, 28 insertions(+), 47 deletions(-)

diff --git a/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi b/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi
index a07db3545c78..f735e3429b70 100644
--- a/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi
+++ b/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi
@@ -44,6 +44,7 @@ adc_en_state: adc-grp {
 
 	sound {
 		compatible = "simple-audio-card";
+		status = "disabled";
 		#address-cells = <1>;
 		#size-cells = <0>;
 		simple-audio-card,name = "sound";
@@ -285,6 +286,7 @@ gige-reset-hog {
 
 	dac: audio-codec@4 {
 		compatible = "adi,adau1962";
+		status = "disabled";
 		reg = <0x4>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&dac_en_state>;
@@ -294,6 +296,7 @@ dac: audio-codec@4 {
 
 	adc: audio-codec@11 {
 		compatible = "adi,adau1979";
+		status = "disabled";
 		reg = <0x11>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&adc_en_state>;
@@ -302,6 +305,17 @@ adc: audio-codec@11 {
 	};
 };
 
+/*
+ * SHARC core 1 configures the codecs over TWI2, so the SHARCs hold the codec
+ * enables. As a simple-pm-bus, the bus only adds the SHARCs, which remoteproc
+ * starts, after Linux has set up the i2c2 devices that the enables need.
+ */
+&rproc_bus {
+	compatible = "simple-pm-bus";
+	pinctrl-names = "default";
+	pinctrl-0 = <&dac_en_state>, <&adc_en_state>;
+};
+
 &emac0 {
 	snps,reset-active-low;
 	snps,reset-delays-us = <0 200 500>;
@@ -381,11 +395,11 @@ &i2s4 {
 	pinctrl-0 = <&sru_dai1>;
 	sound-name-prefix = "SPORT4";
 
-	status = "okay";
+	status = "disabled";
 };
 
 &sru_ctrl_dai1 {
-	status = "okay";
+	status = "disabled";
 
 	sru_dai1: sru_dai1_mux {
 		route {
diff --git a/arch/arm64/boot/dts/adi/sc598-som.dtsi b/arch/arm64/boot/dts/adi/sc598-som.dtsi
index b338d4394a31..fdfd59514506 100644
--- a/arch/arm64/boot/dts/adi/sc598-som.dtsi
+++ b/arch/arm64/boot/dts/adi/sc598-som.dtsi
@@ -28,10 +28,10 @@ memory@90000000 {
 		reg = <0x90000000 0x0e000000>;
 	};
 
-	memory@20040000 {
-		device_type = "memory";
-		reg = <0x20040000 0x40000>;
-	};
+//	memory@20040000 {
+//		device_type = "memory";
+//		reg = <0x20040000 0x40000>;
+//	};
 
 	reserved-memory {
 		//sram1_res: sram1-reserved@20040000 {
@@ -72,7 +72,7 @@ sram2: sram-reserved@200C8000 {
 
 
 	scb {
-		remoteproc { // XXX find a better name than "remoteproc"
+		rproc_bus: remoteproc { // XXX find a better name than "remoteproc"
 			compatible = "simple-bus";
 
 			#address-cells = <2>;
@@ -94,7 +94,7 @@ sharc@0 {
 				      <0x0 0x20000000 0x00200000>;
 				reg-names = "l1", "l2";
 				core-id = <1>;
-				firmware-name = "adi/icap_device_example_sharc_core1.ldr";
+				firmware-name = "adi/icap_sharc_alsa_core1.ldr";
 				interrupts = <GIC_SPI 337 IRQ_TYPE_EDGE_RISING>; /* TRU0_SLV3 */
 				adi,svect = <&rcu 0x30>;
 				resets = <&rcu 1 0>, <&rcu 1 1>;
@@ -111,7 +111,7 @@ sharc@1 {
 				      <0x1 0x20000000 0x00200000>;
 				reg-names = "l1", "l2";
 				core-id = <2>;
-				firmware-name = "adi/rpmsg_echo_sharc_core2.ldr";
+				firmware-name = "adi/icap_sharc_alsa_core2.ldr";
 				interrupts = <GIC_SPI 337 IRQ_TYPE_EDGE_RISING>; /* TRU0_SLV3 */
 				adi,svect = <&rcu 0x34>;
 				resets = <&rcu 2 0>, <&rcu 2 1>;
diff --git a/arch/arm64/boot/dts/adi/sc59x-64.dtsi b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
index b88429d3b196..93ed9a0e59b7 100644
--- a/arch/arm64/boot/dts/adi/sc59x-64.dtsi
+++ b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
@@ -368,7 +368,7 @@ sram-controller@31080000 {
 			reg = <0x31080000 0x100>;
 			adi,sram = <&sram0>, <&sram1>;
 			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
-			status = "disabled";
+			status = "okay";
 		};
 
 		sram_mmap: sram-mmap@0 {
diff --git a/arch/arm64/configs/sc598-som-ezkit_defconfig b/arch/arm64/configs/sc598-som-ezkit_defconfig
index 00846f31115c..09a577d2f658 100644
--- a/arch/arm64/configs/sc598-som-ezkit_defconfig
+++ b/arch/arm64/configs/sc598-som-ezkit_defconfig
@@ -209,6 +209,7 @@ CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_SOC=y
 CONFIG_SND_SOC_ADI_ADSP_SPORT=y
+CONFIG_SND_SC5XX_SHARC_ALSA_CARD=y
 CONFIG_SND_SOC_ADAU1977_I2C=y
 CONFIG_SND_SOC_ADAU1962_I2C=y
 CONFIG_SND_SIMPLE_CARD=y
@@ -271,6 +272,8 @@ CONFIG_RPMSG_CHAR=y
 CONFIG_RPMSG_CTRL=y
 CONFIG_RPMSG_QCOM_GLINK_RPM=y
 CONFIG_RPMSG_VIRTIO=y
+CONFIG_RPMSG_ADI=y
+CONFIG_RPMSG_NS=y
 CONFIG_PM_DEVFREQ=y
 CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
 CONFIG_IIO=y
diff --git a/drivers/soc/adi/mach-sc5xx/sec.c b/drivers/soc/adi/mach-sc5xx/sec.c
index f392f1e22cc8..22a2d1578358 100644
--- a/drivers/soc/adi/mach-sc5xx/sec.c
+++ b/drivers/soc/adi/mach-sc5xx/sec.c
@@ -34,12 +34,11 @@ struct adi_sec {
 
 void adi_sec_writel(u32 val, struct adi_sec *rcu, int offset)
 {
-	writel(val, rcu->ioaddr + offset);
 }
 
 u32 adi_sec_readl(struct adi_sec *rcu, int offset)
 {
-	return readl(rcu->ioaddr + offset);
+	return 0;
 }
 
 void sec_raise_irq(struct adi_sec *sec, unsigned int irq)
@@ -136,7 +135,6 @@ static int adi_sec_probe(struct platform_device *pdev)
 	struct adi_rcu *adi_rcu;
 	struct resource *res;
 	void __iomem *base;
-	int cores;
 	int ret = 0;
 
 	adi_sec = devm_kzalloc(dev, sizeof(*adi_sec), GFP_KERNEL);
@@ -175,40 +173,6 @@ static int adi_sec_probe(struct platform_device *pdev)
 
 	adi_sec->ioaddr = base;
 
-	/* Disable SYSCD_RESETb and clear RCU reset status */
-	adi_rcu_writel(0x00, adi_rcu, ADI_RCU_REG_CTL);
-	adi_rcu_writel(0x0f, adi_rcu, ADI_RCU_REG_STAT);
-
-	/* Reset SEC */
-	adi_sec_writel(0x02, adi_sec, ADI_SEC_REG_GCTL);
-	adi_sec_writel(0x02, adi_sec, ADI_SEC_REG_FCTL);
-
-	/* Initialize each core */
-	for (cores = 0; cores < adi_sec->cores; ++cores) {
-		adi_sec_writel(0x02, adi_sec,
-			       ADI_SEC_REG_CCTL_BASE + (cores +
-							1) *
-			       ADI_SEC_CCTL_SIZE);
-	}
-	udelay(100);
-
-	/* Enable SEC fault event */
-	adi_sec_writel(0x01, adi_sec, ADI_SEC_REG_GCTL);
-
-	/* ANOMALY 36100004 spurious external fault event occurs when FCTL is
-	 * re-programmed when active fault is not cleared
-	 */
-	adi_sec_writel(0xc0, adi_sec, ADI_SEC_REG_FCTL);
-	adi_sec_writel(0xc1, adi_sec, ADI_SEC_REG_FCTL);
-
-	/* Enable SYSCD_RESETb input */
-	adi_rcu_writel(0x100, adi_rcu, ADI_RCU_REG_CTL);
-
-#ifdef CONFIG_ADI_WATCHDOG
-	/* @todo verify sec watchdog event number, make device tree based */
-	sec_enable_ssi(adi_sec, 3, true, true);
-#endif
-
 	return 0;
 
 free_rcu:
-- 
2.34.1

