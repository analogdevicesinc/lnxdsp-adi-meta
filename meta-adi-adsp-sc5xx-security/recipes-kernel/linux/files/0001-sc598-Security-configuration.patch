From c265167bc5a0fbae1f8437bb23824d8d3469ea9e Mon Sep 17 00:00:00 2001
From: Caleb Ethridge <caleb.ethridge@analog.com>
Date: Mon, 17 Aug 2026 09:07:48 -0400
Subject: [PATCH] sc598: Security configuration

Upstream-Status: Inappropriate [embedded specific]

Disable peripherals restricted by the SPU:
- SEC
- RCU reboot
- remoteproc because it uses the RCU and accesses L2 directly
- TRNG
- PKTE (security packet engine)

Enable:
- OPTEE support
- ARM PSCI support to reboot with TFA
- ADI_RPMSG as a module (adi_rpmsg) to communicate after loading SHARCs
- TRU uses SMC method to request triggers

Signed-off-by: Caleb Ethridge <caleb.ethridge@analog.com>
---
 arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi |  2 +-
 arch/arm64/boot/dts/adi/sc598-som.dtsi       | 36 ++++++++++++++++++--
 arch/arm64/boot/dts/adi/sc59x-64.dtsi        | 11 ++++--
 arch/arm64/configs/sc598-som-ezkit_defconfig |  3 ++
 4 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi b/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi
index a07db3545c78..c705c6171fec 100644
--- a/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi
+++ b/arch/arm64/boot/dts/adi/sc598-som-ezkit.dtsi
@@ -407,7 +407,7 @@ route {
 };
 
 &pkte1 {
-	status = "okay";
+	status = "disabled";
 	mode = "arm";        /* autonomous ring mode */
 	/* mode = "tcm"; */  /* target command mode  */
 	/* mode = "dhm"; */  /* direct host mode     */
diff --git a/arch/arm64/boot/dts/adi/sc598-som.dtsi b/arch/arm64/boot/dts/adi/sc598-som.dtsi
index cc3b27f7f3b1..1b43ea051e4c 100644
--- a/arch/arm64/boot/dts/adi/sc598-som.dtsi
+++ b/arch/arm64/boot/dts/adi/sc598-som.dtsi
@@ -62,6 +62,30 @@ vdev1buffer: vdev1buffer@200a8000 {
 		};
 	};
 
+	sharc0_rpmsg: core0-rpmsg {
+		compatible = "adi,rpmsg-sc598";
+		core-id = <1>;
+		adi,rcu = <&rcu>;
+		adi,rsc-table = <&rsc_tbl0>;
+		interrupts = <GIC_SPI 337 IRQ_TYPE_EDGE_RISING>; /* TRU0_SLV3 */
+		mboxes = <&tru 135>; /* trigger master SOFT4 */
+		mbox-names = "tru";
+		vdev-vring = <&vdev0vrings>;
+		memory-region = <&vdev0buffer>;
+	};
+
+	sharc1_rpmsg: core1-rpmsg {
+		compatible = "adi,rpmsg-sc598";
+		core-id = <2>;
+		adi,rcu = <&rcu>;
+		adi,rsc-table = <&rsc_tbl1>;
+		interrupts = <GIC_SPI 337 IRQ_TYPE_EDGE_RISING>; /* TRU0_SLV3 */
+		mboxes = <&tru 136>; /* trigger master SOFT5 */
+		mbox-names = "tru";
+		vdev-vring = <&vdev1vrings>;
+		memory-region = <&vdev1buffer>;
+	};
+
 	sram1_mmap: sram-mmap {
 		compatible = "adi,sram-mmap";
 		memory-region = <&sram1_res>;
@@ -99,7 +123,7 @@ sharc@0 {
 				mboxes = <&tru 135>; /* trigger master SOFT4 */
 				mbox-names = "kick";
 				adi,rsc-table = <&rsc_tbl0>;
-				status = "okay";
+				status = "disabled";
 			};
 
 			sharc@1 {
@@ -116,10 +140,18 @@ sharc@1 {
 				mboxes = <&tru 136>; /* trigger master SOFT5 */
 				mbox-names = "kick";
 				adi,rsc-table = <&rsc_tbl1>;
-				status = "okay";
+				status = "disabled";
 			};
 		};
 	};
+
+	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+	};
+
 };
 
 &tru {
diff --git a/arch/arm64/boot/dts/adi/sc59x-64.dtsi b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
index a8ac7ca6ace5..43a5ce67fdc6 100644
--- a/arch/arm64/boot/dts/adi/sc59x-64.dtsi
+++ b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
@@ -67,6 +67,11 @@ pmu {
 		interrupt-parent = <&gic>;
 	};
 
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
 	gic: interrupt-controller@31200000 {
 		compatible = "arm,gic-v3";
 		#interrupt-cells = <3>;
@@ -256,7 +261,6 @@ rcu: rcu@3108c000 {
 			adi,sharc-min = <1>;
 			adi,sharc-max = <2>;
 			adi,core-stop-irqs = <106 107>;
-			adi,enable-reboot;
 			status = "okay";
 		};
 
@@ -265,7 +269,7 @@ sec: sec@31089000 {
 			reg = <0x31089000 0x1000>;
 			adi,rcu = <&rcu>;
 			adi,sharc-cores = <2>;
-			status = "okay";
+			status = "disabled";
 		};
 
 		tru: mailbox@3108a000 {
@@ -274,6 +278,7 @@ tru: mailbox@3108a000 {
 			#mbox-cells = <1>;
 			adi,max-master-id = <182>;
 			adi,max-slave-id = <187>;
+			adi,use-smc;
 			status = "okay";
 		};
 
@@ -1570,7 +1575,7 @@ trng: rng@310d0000 {
 			alarm-thresh  = <0xff>;
 			shdn-thresh = <0x04>;
 			poll-data = <0>; /* Use IRQ for data */
-			status = "okay";
+			status = "disabled";
 		};
 	};
 };
diff --git a/arch/arm64/configs/sc598-som-ezkit_defconfig b/arch/arm64/configs/sc598-som-ezkit_defconfig
index 9ce6b8229765..70796ae58c3b 100644
--- a/arch/arm64/configs/sc598-som-ezkit_defconfig
+++ b/arch/arm64/configs/sc598-som-ezkit_defconfig
@@ -273,12 +273,15 @@ CONFIG_RPMSG_CHAR=y
 CONFIG_RPMSG_CTRL=y
 CONFIG_RPMSG_QCOM_GLINK_RPM=y
 CONFIG_RPMSG_VIRTIO=y
+CONFIG_RPMSG_ADI=m
 CONFIG_PM_DEVFREQ=y
 CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
 CONFIG_IIO=y
 CONFIG_PHY_QCOM_USB_HS=y
 CONFIG_HISI_PMU=y
 CONFIG_MUX_GPIO=y
+CONFIG_TEE=y
+CONFIG_OPTEE=y
 CONFIG_EXT2_FS=y
 CONFIG_EXT4_FS=y
 CONFIG_EXT4_FS_POSIX_ACL=y
-- 
2.34.1

